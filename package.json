{
  "name": "react-native-gradient-wrapper",
  "version": "1.1.0",
  "description": "A flexible React Native gradient wrapper component with animated border and background gradients.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./expo": {
      "source": "./src/expo.ts",
      "import": {
        "types": "./lib/typescript/module/expo.d.ts",
        "default": "./lib/module/expo.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/expo.d.ts",
        "default": "./lib/commonjs/expo.js"
      }
    },
    "./linear-gradient": {
      "source": "./src/linear-gradient.ts",
      "import": {
        "types": "./lib/typescript/module/linear-gradient.d.ts",
        "default": "./lib/module/linear-gradient.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/linear-gradient.d.ts",
        "default": "./lib/commonjs/linear-gradient.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "expo",
    "linear-gradient",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && prettier --check \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" && eslint --fix \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "bob build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "react-native",
    "gradient",
    "linear-gradient",
    "wrapper",
    "animated",
    "border",
    "component",
    "animated gradient",
    "border gradient",
    "gradient button",
    "theme gradient",
    "gradient animation",
    "react-native-linear-gradient",
    "glow effect",
    "neon gradient",
    "galaxy gradient"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bersuad/react-native-gradient-wrapper"
  },
  "bugs": {
    "url": "https://github.com/bersuad/react-native-gradient-wrapper/issues"
  },
  "homepage": "https://github.com/bersuad/react-native-gradient-wrapper#readme",
  "author": "Bersufekad Adane",
  "license": "MIT",
  "peerDependencies": {
    "expo-linear-gradient": ">=11.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.68.0",
    "react-native-linear-gradient": "^2.8.3"
  },
  "peerDependenciesMeta": {
    "expo-linear-gradient": {
      "optional": true
    },
    "react-native-linear-gradient": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.80.1",
    "@react-native/eslint-config": "^0.80.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.10.0",
    "react": "19.1.0",
    "react-native": "0.80.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-linear-gradient": "^2.8.3",
    "test-renderer": "^1.3.1",
    "typescript": "^5.9.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
